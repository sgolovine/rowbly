{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.agents", "!**/.claude", "!**/skills", "!**/rowbly-test", "!**/.rowbly"]
  },
  // The website CSS uses Tailwind CSS v4 directives, for example `@theme`, `@apply` and `@custom-variant`.
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      }
    }
  },
  "overrides": [
    // TanStack Router gives a meaning to characters in route file names, for example `$.tsx`, `-helpers.tsx`,
    // `script[.]js.tsx` and `{-$locale}.tsx`. The `match` option of `useFilenamingConvention` cannot express a
    // name with a variable number of dot-separated route parts, so the rule is off only in this folder.
    // `scripts/check-names.mjs` checks these names instead: each word in them must still be dash-case.
    {
      "includes": ["packages/website/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/cli/src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": [
        "./biome-plugins/no-nested-function.grit",
        "./biome-plugins/no-let.grit",
        "./biome-plugins/no-member-assign.grit",
        "./biome-plugins/no-mutating-call.grit"
      ],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "error",
            "noNestedTernary": "error",
            "noParameterAssign": "error",
            "noIncrementDecrement": "error",
            "noUselessElse": "error",
            "useReadonlyClassProperties": "error",
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 400
              }
            }
          },
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 60
              }
            },
            "noExcessiveCognitiveComplexity": "error"
          },
          "performance": {
            "noDelete": "error"
          }
        }
      }
    }
  ]
}
