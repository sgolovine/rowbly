{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.agents", "!**/.claude", "!**/skills", "!**/rowbly-test", "!**/.rowbly"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["src/services/factoryManager/**", "!**/*.test.ts"],
      "plugins": [
        "./biome-plugins/no-nested-function.grit",
        "./biome-plugins/no-let.grit",
        "./biome-plugins/no-member-assign.grit",
        "./biome-plugins/no-mutating-call.grit"
      ],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "error",
            "noNestedTernary": "error",
            "noParameterAssign": "error",
            "noIncrementDecrement": "error",
            "noUselessElse": "error",
            "useReadonlyClassProperties": "error",
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 400
              }
            }
          },
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 60
              }
            },
            "noExcessiveCognitiveComplexity": "error"
          },
          "performance": {
            "noDelete": "error"
          }
        }
      }
    }
  ]
}
