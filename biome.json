{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!docs", "!pnpm-lock.yaml", "!.intent"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "fs": "Only src/storage/ may touch the filesystem (README §3).",
              "node:fs": "Only src/storage/ may touch the filesystem (README §3).",
              "fs/promises": "Only src/storage/ may touch the filesystem (README §3).",
              "node:fs/promises": "Only src/storage/ may touch the filesystem (README §3)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/storage/**", "test/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
