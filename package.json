{
  "name": "rowbly",
  "version": "0.1.0",
  "description": "A developer-focused, file-backed Kanban tracker for the terminal.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rowbly": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "bench:plugins": "tsx test/performance/bench.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "fractional-indexing": "^4.0.0",
    "ink": "^8.0.0",
    "nanoid": "^6.0.2",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/intent": "^0.5.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
