{
  "name": "rowbly",
  "version": "0.16.0",
  "description": "Rowbly CLI and TUI",
  "type": "module",
  "bin": {
    "rowbly": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "stages",
    "!skills/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:factory": "node --test skills/factory/scripts/*.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@mariozechner/clipboard": "0.3.9",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "ink": "^8.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.1",
    "react": "^19.3.1",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1",
    "@earendil-works/pi-coding-agent": "1.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@codebolt/agentic-tui": "0.3.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "knip": "^6.44.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@earendil-works/pi-ai": "1.5.2",
    "typebox": "1.4.7"
  }
}
